[Unit]
Description=AAPL AI Trading Indicator Live Backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/aapl_indicator
EnvironmentFile=/opt/aapl_indicator/.env
ExecStart=/opt/aapl_indicator/venv/bin/uvicorn src.live.app:app --host 127.0.0.1 --port 8000 --workers 1
Restart=always
RestartSec=5
TimeoutStopSec=15
KillSignal=SIGINT
StandardOutput=journal
StandardError=journal
SyslogIdentifier=aapl-indicator

# Resource limits
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target

