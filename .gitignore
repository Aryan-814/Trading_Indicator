data/clean/*
!data/clean/.gitkeep
data/features/*
!data/features/.gitkeep
data/live/
backups/
*.db
*.db-wal
*.db-shm
aapl_5m_clean.csv
*.csv
!reports/*.csv
*.parquet
!models/v1/*.parquet

# Logs and runtime outputs
*.log
reports/*.log

# Unit test / coverage reports
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/

# Jupyter Notebook checkpoints
.ipynb_checkpoints/
*/.ipynb_checkpoints/*

